---
import { Font } from 'astro:assets';
import profile from '../assets/profile.jpeg';
import config from '../site.config';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	/** Keep the page out of search results (the 404 page). */
	noindex?: boolean;
}

const { title = config.site.title, description = config.site.description, noindex = false } = Astro.props;
const { person, site } = config;

const absolute = (pathname: string) => new URL(pathname, site.url).href;
const canonical = absolute(Astro.url.pathname);
const ogImage = absolute(site.ogImage.path);
const ogImageAlt = `${person.name}: ${person.headline} ${person.role} at ${person.company}.`;
const [firstName, ...lastNames] = person.name.split(' ');

// A profile page about one person (schema.org ProfilePage + Person), and the site itself.
const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'ProfilePage',
		url: canonical,
		name: title,
		inLanguage: site.locale,
		mainEntity: {
			'@type': 'Person',
			'@id': `${absolute('/')}#person`,
			name: person.name,
			alternateName: person.handle,
			description,
			url: absolute('/'),
			image: absolute(profile.src),
			email: `mailto:${person.email}`,
			jobTitle: person.role,
			worksFor: { '@type': 'Organization', name: person.company },
			address: { '@type': 'PostalAddress', addressLocality: person.city, addressCountry: 'CZ' },
			knowsAbout: person.knowsAbout,
			knowsLanguage: site.locale,
			sameAs: config.links.map((link) => link.href),
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		url: absolute('/'),
		name: person.name,
		inLanguage: site.locale,
		author: { '@id': `${absolute('/')}#person` },
	},
];
---

<!doctype html>
<html lang={site.locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content={person.name} />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="me" href={config.mastodon} />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#0f1114" />
		<meta name="color-scheme" content="dark" />

		<!-- Sharing: Open Graph (LinkedIn, Slack, Facebook, Discord…) and X. -->
		<meta property="og:type" content="profile" />
		<meta property="og:site_name" content={person.name} />
		<meta property="og:locale" content={site.ogLocale} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content={String(site.ogImage.width)} />
		<meta property="og:image:height" content={String(site.ogImage.height)} />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="profile:first_name" content={firstName} />
		<meta property="profile:last_name" content={lastNames.join(' ')} />
		<meta property="profile:username" content={person.handle} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content={`@${person.handle}`} />
		<meta name="twitter:creator" content={`@${person.handle}`} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={ogImageAlt} />

		<Font cssVariable="--font-mono" preload />
		<Font cssVariable="--font-sans" preload />
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		<!-- Interactive parts hide their extra panels only when the script that switches them can run. -->
		<script is:inline>document.documentElement.classList.add('js');</script>
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<div id="top" class="pg">
			<slot />
		</div>
	</body>
</html>
