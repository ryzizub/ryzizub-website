---
import Base from '../layouts/Base.astro';
import Apps from '../components/Apps.astro';
import Contact from '../components/Contact.astro';
import Dock from '../components/Dock.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Logos from '../components/Logos.astro';
import Palette from '../components/Palette.astro';
import SideQuests from '../components/SideQuests.astro';
import Talks from '../components/Talks.astro';
import Websites from '../components/Websites.astro';
---

<Base>
	<Header />
	<main id="main" tabindex="-1">
		<section class="hero w" aria-label="What I build">
			<Palette />
			<Dock />
		</section>
		<Logos />
		<Apps />
		<Websites />
		<SideQuests />
		<Talks />
		<Contact />
	</main>
	<Footer />
</Base>

<style>
	.hero {
		padding-top: clamp(48px, 8cqw, 120px);
	}

	main:focus {
		outline: none;
	}
</style>
