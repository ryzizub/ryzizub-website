---
interface Props {
	/** The command that opens the section, e.g. "/apps". */
	command: string;
	title: string;
	intro: string;
}

const { command, title, intro } = Astro.props;
---

<div class="sh">
	<h2><span class="pfx">{command}</span>{title}</h2>
	<p>{intro}</p>
</div>

<style>
	.sh {
		display: grid;
		gap: 14px;
		margin-bottom: 40px;
	}

	h2 {
		font-size: clamp(32px, 4cqw, 50px);
		font-weight: 600;
		line-height: 1.08;
		letter-spacing: -0.03em;
		text-wrap: balance;
	}

	/* The command sits in the title line, not above it. */
	.pfx {
		margin-right: 12px;
		font-family: var(--mono);
		font-size: clamp(16px, 2cqw, 25px);
		font-weight: 500;
		letter-spacing: -0.01em;
		color: var(--acc);
		vertical-align: 0.3em;
	}

	p {
		max-width: 36em;
		font-size: 17px;
		color: var(--mut);
	}
</style>
