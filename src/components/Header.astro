---
import config from '../site.config';

const { person, nav } = config;
---

<header class="top w">
	<div class="id">
		<a class="wm" href="#top">{person.name}<i aria-hidden="true"></i></a>
		<span class="role">{person.role} at {person.company}</span>
	</div>
	<nav aria-label="Sections">
		<ul class="cmds">
			{nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
		</ul>
	</nav>
</header>

<style>
	.top {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 10px 28px;
		padding-top: 28px;
	}

	.id {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		column-gap: 18px;
	}

	/* The name set in the mono is the wordmark, with the caret as its mark. */
	.wm {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		min-height: 44px;
		font-family: var(--mono);
		font-size: 18px;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--ink);
	}

	.wm i {
		width: 10px;
		height: 20px;
		border-radius: 2px;
		background: var(--acc);
	}

	.role {
		font-size: 15px;
		color: var(--mut);
	}
</style>
