---
// A chord sheet whose highlighted line moves down like Follow Mode,
// mirrored on three band members' phones over Bluetooth. Drawn, not a screenshot.
const rows = [
	{ chords: [['G', 32], ['D', 92], ['Em', 150]], width: 160 },
	{ chords: [['C', 32], ['G', 104]], width: 140 },
	{ chords: [['Am', 32], ['F', 84], ['C', 150]], width: 165 },
	{ chords: [['G', 32], ['D', 120]], width: 120 },
] as const;
const phones = [232, 262, 292];
---

<svg class="art" viewBox="0 0 320 160" aria-hidden="true">
	<rect class="sheet" x="16" y="12" width="196" height="136" rx="12"></rect>
	<rect class="hl" x="24" y="24" width="180" height="27" rx="7"></rect>
	{
		rows.map((row, i) => (
			<>
				{row.chords.map(([chord, x]) => (
					<text class="ch" x={x} y={38 + i * 28}>
						{chord}
					</text>
				))}
				<rect class="ly" x="32" y={44 + i * 28} width={row.width} height="5" rx="2.5" />
			</>
		))
	}
	<path class="wire" d="M272 70 V88 M272 70 L242 89 M272 70 L302 89"></path>
	<path class="sig" d="M258 44 q-5 8 0 16 M286 44 q5 8 0 16"></path>
	<path class="ble" d="M265 46 L279 58 L272 64 L272 38 L279 44 L265 56"></path>
	{
		phones.map((x) => (
			<>
				<rect class="dev" x={x} y="90" width="20" height="36" rx="5" />
				{[98, 105, 112, 119].map((y) => (
					<rect class="ly" x={x + 5} y={y} width="10" height="2.5" rx="1.25" />
				))}
				<rect class="hls" x={x + 3} y="96.5" width="14" height="5.5" rx="1.5" />
			</>
		))
	}
</svg>

<style>
	.art {
		width: 100%;
		max-width: 330px;
		height: auto;
		overflow: visible;
	}

	.sheet,
	.dev {
		fill: var(--pan);
		stroke: var(--edge);
		stroke-width: 1.5;
	}

	.ly {
		fill: #2e333b;
	}

	.ch {
		font-family: var(--mono);
		font-size: 11px;
		font-weight: 700;
		fill: var(--acc);
	}

	.hl {
		fill: rgba(255, 122, 47, 0.12);
		stroke: var(--acc);
		stroke-width: 1.5;
		animation: refrane-follow 6s infinite;
	}

	.hls {
		fill: var(--acc);
		animation: refrane-follow-phone 6s infinite;
	}

	.ble {
		fill: none;
		stroke: var(--acc);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.sig {
		fill: none;
		stroke: var(--mut);
		stroke-width: 1.5;
		stroke-linecap: round;
	}

	.wire {
		fill: none;
		stroke: var(--edge);
		stroke-width: 1.5;
		stroke-dasharray: 3 4;
	}

	@keyframes refrane-follow {
		0%,
		22% {
			transform: translateY(0);
		}
		25%,
		47% {
			transform: translateY(28px);
		}
		50%,
		72% {
			transform: translateY(56px);
		}
		75%,
		97% {
			transform: translateY(84px);
		}
		100% {
			transform: translateY(0);
		}
	}

	@keyframes refrane-follow-phone {
		0%,
		22% {
			transform: translateY(0);
		}
		25%,
		47% {
			transform: translateY(7px);
		}
		50%,
		72% {
			transform: translateY(14px);
		}
		75%,
		97% {
			transform: translateY(21px);
		}
		100% {
			transform: translateY(0);
		}
	}
</style>
