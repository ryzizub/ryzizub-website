---
import { getCollection } from 'astro:content';
import config from '../site.config';
import profile from '../assets/profile.jpeg';
import { asset, imageData } from '../lib/assets';
import AppIcon from './AppIcon';
import Icon from './Icon';

const byOrder = <T extends { data: { order: number } }>(a: T, b: T) => a.data.order - b.data.order;
const credentials = (await getCollection('credentials')).sort(byOrder).map((entry) => entry.data);
const apps = (await getCollection('apps')).sort(byOrder).map((entry) => entry.data);
const { person } = config;
---

<div class="dock">
	<figure class="wd photo">
		<img src={profile.src} width={profile.width} height={profile.height} alt={person.name} />
		<figcaption class="tag"><Icon name="pin" />{person.city}</figcaption>
	</figure>

	<div class="wd cred">
		<p class="m">Credentials</p>
		<ul>
			{
				credentials.map((credential) => {
					const mark = asset(credential.mark);
					return (
						<li>
							<span class="mk">
								<img src={mark.src} width={credential.markWidth} height={Math.round((credential.markWidth * mark.height) / mark.width)} alt="" />
							</span>
							<span>
								<b>{credential.title}</b>
								<em>{credential.detail}</em>
							</span>
						</li>
					);
				})
			}
		</ul>
	</div>

	<a class="wd spk" href={`mailto:${person.email}`}>
		<span class="m">Speaking</span>
		<span class="n">{person.talks}</span>
		<span class="u">talks</span>
		<span class="t">
			<span><small>Got a stage?</small><b>Invite me to speak</b></span>
			<span class="fgo" aria-hidden="true"><Icon name="arrow" /></span>
		</span>
	</a>

	<a class="wd folder" href="#apps">
		<span class="ics" aria-hidden="true">
			{apps.map((app) => <AppIcon image={imageData(app.icon)} padded={app.padded} dark={app.dark} className="ic" />)}
		</span>
		<span class="ft">
			<span><b>Shipped</b><em>Clients, startups and communities</em></span>
			<span class="fgo" aria-hidden="true"><Icon name="arrow" /></span>
		</span>
	</a>
</div>

<style>
	.dock {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 20px;
		margin-top: clamp(52px, 5.6cqw, 72px);
	}

	@container (min-width: 761px) {
		.dock {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr) minmax(0, 1fr) minmax(0, 1fr);
		}
	}

	.wd {
		position: relative;
		display: flex;
		flex-direction: column;
		min-width: 0;
		min-height: 270px;
		margin: 0;
		border-radius: 22px;
		overflow: hidden;
	}

	a.wd {
		transition: transform 0.25s cubic-bezier(0.2, 1, 0.3, 1);
	}

	a.wd:hover {
		transform: translateY(-3px);
	}

	.m {
		font-family: var(--mono);
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.fgo {
		flex: none;
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		border-radius: 11px;
		background: var(--tile);
		color: var(--ink);
	}

	.fgo :global(svg) {
		width: 18px;
		height: 18px;
	}

	/* photo */
	.photo {
		background: var(--tile);
		box-shadow: inset 0 0 0 1px var(--line);
	}

	.photo img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 50% 38%;
	}

	.tag {
		position: absolute;
		left: 12px;
		bottom: 12px;
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 7px 12px 7px 10px;
		border-radius: 11px;
		background: rgba(15, 17, 20, 0.88);
		font-family: var(--mono);
		font-size: 13px;
		line-height: 1.3;
		color: var(--ink);
	}

	.tag :global(svg) {
		width: 14px;
		height: 14px;
		color: var(--acc);
	}

	/* credentials */
	.cred {
		padding: 16px 16px 14px;
		background: var(--light);
		color: var(--dark);
	}

	.cred .m {
		color: var(--light-ink);
	}

	.cred ul {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: space-evenly;
		gap: 12px;
		margin-top: 10px;
	}

	.cred li {
		display: grid;
		grid-template-columns: 40px minmax(0, 1fr);
		align-items: center;
		gap: 12px;
	}

	.mk {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
		border-radius: 11px;
		background: #ffffff;
	}

	.cred b {
		display: block;
		font-size: 15.5px;
		font-weight: 600;
		line-height: 1.25;
		letter-spacing: -0.01em;
	}

	.cred em {
		display: block;
		font-size: 14px;
		font-style: normal;
		line-height: 1.35;
		color: var(--light-ink);
	}

	/* speaking */
	.spk,
	.spk:hover {
		padding: 16px;
		background: var(--acc);
		color: var(--dark);
	}

	.spk:focus-visible {
		outline-color: var(--ink);
	}

	.n {
		margin-top: 6px;
		font-family: var(--mono);
		font-size: 88px;
		font-weight: 800;
		line-height: 0.9;
		letter-spacing: -0.07em;
	}

	.u {
		margin-top: 6px;
		font-family: var(--mono);
		font-size: 17px;
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.t {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 10px;
		margin-top: auto;
		padding-top: 12px;
		border-top: 1px solid rgba(16, 18, 20, 0.3);
	}

	.t small {
		display: block;
		font-family: var(--mono);
		font-size: 12px;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.t b {
		display: block;
		margin-top: 3px;
		font-size: 19px;
		font-weight: 600;
		line-height: 1.2;
	}

	.spk .fgo {
		background: var(--dark);
	}

	/* shipped folder */
	.folder,
	.folder:hover {
		justify-content: space-between;
		gap: 14px;
		padding: 16px;
		border: 1px solid var(--line);
		background: var(--pan);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
		color: var(--ink);
	}

	.ics {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 8px;
		padding: 10px;
		border-radius: 16px;
		background: var(--low);
		box-shadow: inset 0 0 0 1px var(--line);
	}

	.ics :global(.ic) {
		width: 100%;
		aspect-ratio: 1;
		border-radius: 28%;
	}

	.ft {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 10px;
	}

	.ft b {
		display: block;
		font-size: 17px;
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.ft em {
		display: block;
		margin-top: 1px;
		font-size: 14.5px;
		font-style: normal;
		line-height: 1.3;
		color: var(--mut);
	}

	@container (max-width: 760px) {
		.dock {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 14px;
			margin-top: 44px;
		}

		.wd {
			min-height: 230px;
		}
	}

	@container (max-width: 520px) {
		/* Photo and speaking share a row, credentials take the full width, the folder repeats /apps and goes. */
		.dock {
			grid-auto-flow: dense;
		}

		.cred {
			grid-column: 1 / -1;
			min-height: 0;
		}

		.folder {
			display: none;
		}

		.n {
			font-size: 72px;
		}
	}
</style>
